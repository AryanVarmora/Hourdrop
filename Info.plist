<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.aryanvarmora.sip</string>
    <key>CFBundleName</key>
    <string>Hourdrop</string>
    <key>CFBundleDisplayName</key>
    <string>Hourdrop</string>
    <key>CFBundleExecutable</key>
    <string>Hourdrop</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- App icon: Resources/AppIcon.icns, plus the glass version in Assets.car -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Links like hourdrop://log?ml=250 log a drink (see Sources/DrinkLink.swift) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.aryanvarmora.sip.log</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>hourdrop</string>
            </array>
        </dict>
    </array>
    <!-- Menu bar only: no Dock icon, no app switcher entry -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
